# Copy to .env. Comments must be on their own line: Docker Compose reads an inline
# "# ..." after a value as part of the value.

# Meta Model API key, read only by the backend. Leave empty to run without voice and with
# the rule-based extractor.
MODEL_API_KEY=
ASR_MODEL=muse-voice-transcribe-1.0
ASR_URL=wss://api.meta.ai/v1/asr/realtime
LLM_MODEL=muse-spark-1.3
LLM_BASE_URL=https://api.meta.ai/v1

DATABASE_URL=postgresql+psycopg://kk:kk@db:5432/kirana
REDIS_URL=redis://redis:6379/0

DEMO_SHOP_ID=1
SHOP_LANGUAGE_BIAS=Hindi,English,Telugu

MATCH_WINDOW_MINUTES=10
AUTO_MATCH_THRESHOLD=0.80
BASKET_IDLE_TIMEOUT_SECONDS=300

UDHAAR_REMINDER_THRESHOLD_PAISE=50000
UDHAAR_REMINDER_AFTER_DAYS=7

WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# llm (falls back to rules when MODEL_API_KEY is empty) or rules
EXTRACTOR_BACKEND=llm
